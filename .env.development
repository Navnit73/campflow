# Committed, NON-SECRET defaults for `next dev` (NODE_ENV=development).
# Secrets and personal overrides go in .env.local (git-ignored) — see .env.example.

# Local persistent MongoDB started by `npm run db:local` (replica set → real transactions).
MONGODB_URI=mongodb://127.0.0.1:27017/campflow_local?replicaSet=rs0
NEXT_PUBLIC_APP_URL=http://localhost:3000
EXPORT_RETENTION_DAYS=30
SESSION_CACHE_TTL_MS=30000
