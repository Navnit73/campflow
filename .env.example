# ─────────────────────────────────────────────────────────────────────────────
# CampFlow environment variables — template (committed). Copy to .env.local.
# Full guide: docs/ENVIRONMENTS.md
#
# Next.js load order (first wins): process env → .env.$(NODE_ENV).local →
# .env.local → .env.$(NODE_ENV) → .env   (.env.local is ignored when NODE_ENV=test)
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (REQUIRED) ──────────────────────────────────────────────────────
# The ONLY setting that decides which database the app uses. No silent fallback.
#   local : mongodb://127.0.0.1:27017/campflow_local?replicaSet=rs0   (npm run db:local)
#   dev   : mongodb+srv://<user>:<password>@<dev-cluster>.mongodb.net/campflow_dev?retryWrites=true&w=majority
#   prod  : mongodb+srv://<user>:<password>@<prod-cluster>.mongodb.net/campflow?retryWrites=true&w=majority
# Use a replica set (Atlas or db:local) so bookings run in real transactions.
MONGODB_URI=

# Automated tests only: use a throwaway in-memory DB when MONGODB_URI is empty.
# ALLOW_IN_MEMORY_DB=true

# ── Auth (REQUIRED in production) ────────────────────────────────────────────
# ≥ 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating it signs everyone out.
JWT_SECRET=
# How long a revoked/deactivated user can keep using a session on one instance (ms). Default 30000.
# SESSION_CACHE_TTL_MS=30000

# ── Public URL (REQUIRED in production) ──────────────────────────────────────
# Base URL used in email links (booking confirmation, dashboard). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Scheduled jobs ───────────────────────────────────────────────────────────
# Bearer secret for GET/POST /api/cron/exports (≥ 16 chars). Unset = cron endpoint disabled.
CRON_SECRET=
# Days to keep generated export files (history rows are kept). Default 30.
# EXPORT_RETENTION_DAYS=30

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Empty RESEND_API_KEY = emails are logged, not sent (safe for local).
RESEND_API_KEY=
# Verified sender, e.g. "Pine Park <reservations@yourpark.com>". Required in production when sending.
RESEND_FROM_EMAIL=
# Development only: deliver Resend sandbox-restricted mail to this inbox (attachments withheld).
RESEND_TEST_EMAIL=

# ── Operations ───────────────────────────────────────────────────────────────
# DISABLE_CACHE=true          # bypass aggregate caching (debugging)
# DISABLE_RATE_LIMIT=true     # load tests only — never in production
